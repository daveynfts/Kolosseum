{
  "name": "kolosseum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "radar": "node scripts/radar.mjs",
    "radar:push": "node scripts/radar.mjs",
    "ops:health": "node scripts/radar.mjs health",
    "sync:surf-pdfs": "node scripts/sync_surf_pdfs.mjs",
    "sync:surf-pdfs:apply": "node scripts/sync_surf_pdfs.mjs --apply --fix-existing",
    "feed:refresh-cm": "node scripts/refresh_feed_challenger_master.mjs",
    "research:dev": "tsx scripts/research/server.ts",
    "research:migrate": "tsx scripts/research/migrate.ts",
    "research:evidence": "tsx scripts/research/evidence.ts",
    "research:typecheck": "tsc -p tsconfig.research.json",
    "research:check-surf-auth": "tsx scripts/research/check-surf-auth.ts",
    "research:init-devnet": "tsx scripts/research/init-devnet.ts",
    "research:fund-devnet": "tsx scripts/research/fund-devnet.ts",
    "research:check-secrets": "tsx scripts/research/check-client-secrets.ts",
    "avatars:sync": "node scripts/warm_scex_avatars.mjs",
    "avatars:sync:apply": "node scripts/warm_scex_avatars.mjs --apply",
    "pay:sandbox": "node scripts/research/pay-sandbox.mjs",
    "pay:demo-buy": "pwsh -NoProfile -File scripts/research/demo-buyer.ps1",
    "demo:start": "tsx scripts/research/demo-start.ts",
    "demo:record": "tsx scripts/research/record-demo.ts",
    "demo:export-public": "tsx scripts/research/export-public-demo.ts",
    "test:premium": "node scripts/research/premium-smoke.mjs",
    "test:nft": "tsx scripts/research/nft-smoke.ts",
    "nft:simulate": "tsx scripts/research/simulate-nft.ts",
    "nft:prepare-report": "tsx scripts/research/prepare-premium.ts",
    "nft:upload": "tsx scripts/research/upload-nft.ts",
    "nft:export": "tsx scripts/research/export-nft.ts",
    "nft:review-report": "tsx --tsconfig tsconfig.research.json scripts/research/review-premium.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-uploader-irys": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "@vercel/functions": "^3.7.7",
    "@vercel/node": "^5.8.23",
    "@vercel/og": "^0.11.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.3",
    "mammoth": "^1.12.0",
    "maplibre-gl": "^6.1.0",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
