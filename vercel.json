{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/api/og-conviction-events",
      "destination": "https://radar.daveynfts.com/og/conviction-2026-events.jpg?v=20260805c",
      "permanent": false
    },
    {
      "source": "/api/event-share",
      "destination": "https://radar.daveynfts.com/event-preview.html",
      "permanent": false
    },
    {
      "source": "/api/scex-share",
      "destination": "https://radar.daveynfts.com/scex-preview.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/banner-image",
      "destination": "/api/site-banner"
    },
    {
      "source": "/api/surf-report",
      "destination": "/api/kol-report-image"
    },
    {
      "source": "/r2/:path*",
      "destination": "https://pub-8288264395e64bebab09946b5bc0b740.r2.dev/:path*"
    },
    {
      "source": "/event/:path*",
      "destination": "/"
    },
    {
      "source": "/scex",
      "destination": "/"
    },
    {
      "source": "/scex/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/r2/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon-(32|64).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}
