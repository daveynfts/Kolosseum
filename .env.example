# ─── Client (optional) ───────────────────────────────────────
# Prefill admin token UI (still stored in localStorage after paste)
# VITE_FEED_ADMIN_TOKEN=change-me-long-secret

# ─── Vercel Server (Project → Settings → Environment Variables) ─
# Marketplace → Upstash Redis (or Integrations → Upstash) — auto-injects:
#   UPSTASH_REDIS_REST_URL=
#   UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV names also work:
#   KV_REST_API_URL=
#   KV_REST_API_TOKEN=
#
# Write protection for PUT /api/feed:
FEED_ADMIN_TOKEN=change-me-long-secret
