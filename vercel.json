{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/api/og-conviction-events",
      "destination": "https://radar.daveynfts.com/og/conviction-2026-events.jpg?v=20260805c",
      "permanent": false
    },
    {
      "source": "/api/event-share",
      "destination": "https://radar.daveynfts.com/event-preview.html",
      "permanent": false
    },
    {
      "source": "/api/scex-share",
      "destination": "https://radar.daveynfts.com/scex-preview.html",
      "permanent": false
    },
    {
      "source": "/api/map-share",
      "destination": "https://radar.daveynfts.com/map-preview.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/feed",
      "destination": "/api/json?route=feed"
    },
    {
      "source": "/api/kols",
      "destination": "/api/json?route=kols"
    },
    {
      "source": "/api/scex-tracking",
      "destination": "/api/json?route=scex-tracking"
    },
    {
      "source": "/api/kol-reports",
      "destination": "/api/json?route=kol-reports"
    },
    {
      "source": "/api/recent-followers",
      "destination": "/api/json?route=recent-followers"
    },
    {
      "source": "/api/twitterscore-top100",
      "destination": "/api/json?route=twitterscore-top100"
    },
    {
      "source": "/api/event-side-events",
      "destination": "/api/json?route=event-side-events"
    },
    {
      "source": "/api/media",
      "destination": "/api/bin?route=media"
    },
    {
      "source": "/api/avatar",
      "destination": "/api/bin?route=avatar"
    },
    {
      "source": "/api/x-status",
      "destination": "/api/bin?route=x-status"
    },
    {
      "source": "/api/kol-report-image",
      "destination": "/api/bin?route=kol-report-image"
    },
    {
      "source": "/api/site-banner",
      "destination": "/api/bin?route=site-banner"
    },
    {
      "source": "/api/banner-image",
      "destination": "/api/bin?route=site-banner"
    },
    {
      "source": "/api/surf-report",
      "destination": "/api/bin?route=kol-report-image"
    },
    {
      "source": "/r2/radar/:path*",
      "destination": "/api/bin?route=media&key=radar/:path*"
    },
    {
      "source": "/r2/media/:path*",
      "destination": "/api/bin?route=media&key=media/:path*"
    },
    {
      "source": "/r2/scex-banner/:path*",
      "destination": "/api/bin?route=media&key=scex-banner/:path*"
    },
    {
      "source": "/r2/kol-reports/:path*",
      "destination": "/api/bin?route=media&key=kol-reports/:path*"
    },
    {
      "source": "/r2/RadarKOLsReport/:path*",
      "destination": "/api/bin?route=media&key=RadarKOLsReport/:path*"
    },
    {
      "source": "/r2/:path*",
      "destination": "/api/bin?route=media&key=:path*"
    },
    {
      "source": "/events",
      "destination": "/"
    },
    {
      "source": "/events/",
      "destination": "/"
    },
    {
      "source": "/events/:path*",
      "destination": "/"
    },
    {
      "source": "/event",
      "destination": "/"
    },
    {
      "source": "/event/",
      "destination": "/"
    },
    {
      "source": "/event/:path*",
      "destination": "/"
    },
    {
      "source": "/scex",
      "destination": "/"
    },
    {
      "source": "/scex/:path*",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/r2/radar/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/r2/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r2/scex-banner/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, must-revalidate"
        }
      ]
    },
    {
      "source": "/r2/kol-reports/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, must-revalidate"
        }
      ]
    },
    {
      "source": "/r2/RadarKOLsReport/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon-(32|64).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}
