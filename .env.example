# ─── Client (optional) ───────────────────────────────────────
# Optional public R2 CDN for avatars; local /r2 proxy works without this
# VITE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ─── Feed write protection ───────────────────────────────────
FEED_ADMIN_TOKEN=
# Optional: public API origin for scripts / GitHub Actions
# RADAR_API_BASE=https://radar.daveynfts.com

# ─── Cloudflare R2 (S3-compatible) ───────────────────────────
# Dashboard → R2 → Manage R2 API Tokens → Create API token
# Permission: Object Read & Write on your bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=vn-kol-map

# Optional: public base URL for media (custom domain or r2.dev public bucket)
# If empty, images are served via /api/media?id=...
# Compatible with daveynfts.com project naming:
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# R2_PUBLIC_URL=https://...   (alias — same meaning)

# ─── Kolosseum Deep Research (new sidecar; M1) ───────────────
DEEP_RESEARCH_ENABLED=false
RADAR_API_BASE=https://radar.daveynfts.com
RESEARCH_PORT=4174
# RESEARCH_HOST=127.0.0.1
# RESEARCH_PROXY_TARGET=http://127.0.0.1:4174
# VITE_RESEARCH_API_URL=https://your-research-api.example
# After setting this, run npm run research:check-surf-auth before enabling sandbox payments.
SURF_API_KEY=
SURF_API_BASE_URL=https://api.asksurf.ai/gateway
# Optional local encrypted cache for repeat demos; never commit its contents.
SURF_CACHE_DIR=
# Use none (20 credits) for low-cost local checks; low (50 credits) is the default.
SURF_REASONING_EFFORT=low
DATABASE_URL=
# Optional separate database named kolosseum_test for purchase/vote integration tests.
TEST_DATABASE_URL=
REPORT_ENC_KEY=
ADMIN_TOKEN=
SOLANA_RPC_URL=https://api.devnet.solana.com
OPERATOR_KEYPAIR_PATH=
PAY_MODE=sandbox
PAY_GATEWAY_ENABLED=false
# Local Windows admin-only UI purchase from the pay.sh sandbox CLI wallet.
PAY_DEMO_BUY_ENABLED=false
# Local admin-only replay of an encrypted, Git-ignored capture. Makes no provider or payment calls.
DEMO_REPLAY_ENABLED=false
DEMO_REPLAY_FILE=.demo-captures/flow.json
PAY_ORIGIN_TOKEN=
PAY_GATEWAY_URL=http://127.0.0.1:1402
# Public sandbox gateway signer from `pay --sandbox account list` (channel payee).
PAY_GATEWAY_SIGNER_WALLET=
PAY_SANDBOX_RPC_URL=https://402.surfnet.dev:8899
